#!/usr/bin/env bash
TARGET="${BASH_SOURCE[0]}"
while [ -L "$TARGET" ]; do
    TARGET_DIR="$(cd -P "$(dirname "$TARGET")" && pwd)"
    TARGET="$(readlink "$TARGET")"
    [[ $TARGET != /* ]] && TARGET="$TARGET_DIR/$TARGET"
done
BIN_DIR="$(cd -P "$(dirname "$TARGET")" && pwd)"
exec "${BIN_DIR}/flm" dsh "$@"
